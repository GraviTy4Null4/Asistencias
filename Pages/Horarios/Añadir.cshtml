@page
@model Asistencias.Pages.Horarios.AñadirModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Formulario</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="topnav">
        <a class="active" href="/Index">
            <img src="/Recursos/Logo.png" alt="" id="Logo">
        </a>
        <a href="/Alumnos/Lista">Alumnos</a>
        <a href="/Grupos/Lista">Grupos</a>
        <a href="/Horarios/Lista">Horarios</a>
    </div>
    <form method="post">
        <div class="formulario">
            <div class="TopDiv">
                <label>Dia</label>
                <input type="text" asp-for="Añadir.Dia">
                <label>Hora de entrada</label>
                <input type="time" asp-for="Añadir.Entrada">
                <br />
                <label>Hora de salida</label>
                <input type="time" asp-for="Añadir.Salida">
            </div>
            <div class="BottomDiv">
                @if (Model.Grupo != null && Model.Grupo.Any())
                {
                    <label>Selecciona un grupo</label>
                    <select asp-for="Añadir.GrupoId">
                        @foreach (var Registro in Model.Grupo)
                        {
                            <option value="@Registro.ID">@Registro.GradoGrupo</option>
                        }
                    </select>
                }
            </div>
        </div>
        <div class="buttonContainer">
            <button type="submit" id="gua">Guardar</button>
        </div>
    </form>
</body>
<script src="~/js/site.js" asp-append-version="true"></script>
</html>